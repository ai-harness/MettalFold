# Copy this file to .env and fill the empty slots. Never share .env, never commit it.
PORT=3000
HOST=127.0.0.1

# Login for the local app. Pick a password of at least 8 characters.
APP_PASSWORD=
USERS=Rishabh,Hemant
SESSION_SECRET=

# mock = nothing is sent to real agents (safe testing). live = real webhooks are called.
WEBHOOK_MODE=mock

# Sheet connection: mock (local file) | appsscript | serviceaccount
SHEET_MODE=mock
SHEET_ID=1l6PiDb3wBdD7XWLPx02khyEvD5_UpfMjWJO7OvR4Iz0
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json

POLL_SECONDS=4
DELAY_HINT_SECONDS=300
TIMEOUT_MINUTES=15

# Webhook address and key for each of the six desks (from each routine panel)
SUPPLIER_QUALIFICATION_URL=
SUPPLIER_QUALIFICATION_KEY=
PRODUCT_BOOK_URL=
PRODUCT_BOOK_KEY=
OPPORTUNITY_FINDER_URL=
OPPORTUNITY_FINDER_KEY=
ADVISORY_GTM_URL=
ADVISORY_GTM_KEY=
INTRO_DESK_URL=
INTRO_DESK_KEY=
DEAL_DESK_URL=
DEAL_DESK_KEY=
